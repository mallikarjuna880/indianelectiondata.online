generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ElectionType { LOK_SABHA ASSEMBLY OTHER }
enum SourceStatus { DRAFT REVIEWED PUBLISHED }
enum UserRole { SUPER_ADMIN ADMIN DATA_EDITOR }
enum ImportStatus { UPLOADED VALIDATED IN_REVIEW APPROVED PUBLISHED REJECTED }

model Election {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  electionType ElectionType
  year        Int
  electionDate DateTime?
  description String?
  sourceStatus SourceStatus @default(DRAFT)
  results     CandidateResult[]
  statistics  ConstituencyStatistic[]
  versions    ConstituencyVersion[]
  importBatches ImportBatch[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([electionType, year])
}

model State {
  id             String @id @default(uuid()) @db.Uuid
  name           String
  abbreviation   String?
  stateCode      String?
  constituencies Constituency[]
  createdAt      DateTime @default(now())
  @@unique([name])
}

model Constituency {
  id          String @id @default(uuid()) @db.Uuid
  stateId     String @db.Uuid
  name        String
  state       State @relation(fields: [stateId], references: [id])
  versions    ConstituencyVersion[]
  latitude    Decimal? @db.Decimal(10,7)
  longitude   Decimal? @db.Decimal(10,7)
  createdAt   DateTime @default(now())
  @@index([stateId, name])
}

model ConstituencyVersion {
  id                  String @id @default(uuid()) @db.Uuid
  constituencyId      String @db.Uuid
  electionId          String @db.Uuid
  name                String
  constituencyNumber  Int?
  reservedCategory    String?
  delimitationVersion String?
  constituency        Constituency @relation(fields: [constituencyId], references: [id])
  election            Election @relation(fields: [electionId], references: [id])
  results             CandidateResult[]
  statistics          ConstituencyStatistic[]
  @@unique([constituencyId, electionId])
  @@index([electionId, name])
}

model Party {
  id            String @id @default(uuid()) @db.Uuid
  name          String
  abbreviation  String?
  symbolUrl     String?
  foundedYear   Int?
  dissolvedYear Int?
  results       CandidateResult[]
  @@index([name])
}

model Candidate {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  gender      String?
  dateOfBirth DateTime?
  biography   String?
  photoUrl    String?
  results     CandidateResult[]
  @@index([name])
}

model CandidateResult {
  id                     String @id @default(uuid()) @db.Uuid
  electionId             String @db.Uuid
  constituencyVersionId  String @db.Uuid
  candidateId            String @db.Uuid
  partyId                String? @db.Uuid
  votes                  Int
  voteShare              Decimal? @db.Decimal(8,4)
  position               Int
  isWinner               Boolean @default(false)
  election               Election @relation(fields: [electionId], references: [id])
  constituencyVersion   ConstituencyVersion @relation(fields: [constituencyVersionId], references: [id])
  candidate              Candidate @relation(fields: [candidateId], references: [id])
  party                  Party? @relation(fields: [partyId], references: [id])
  sources                ResultSource[]
  @@unique([electionId, constituencyVersionId, candidateId])
  @@index([electionId, partyId])
}

model ConstituencyStatistic {
  id                    String @id @default(uuid()) @db.Uuid
  electionId            String @db.Uuid
  constituencyVersionId String @db.Uuid
  electors              Int?
  votesPolled           Int?
  validVotes            Int?
  notaVotes             Int?
  turnoutPercentage     Decimal? @db.Decimal(8,4)
  election              Election @relation(fields: [electionId], references: [id])
  constituencyVersion   ConstituencyVersion @relation(fields: [constituencyVersionId], references: [id])
  @@unique([electionId, constituencyVersionId])
}

model DataSource {
  id              String @id @default(uuid()) @db.Uuid
  name            String
  organization    String?
  url             String?
  publicationDate DateTime?
  retrievedAt     DateTime @default(now())
  sourceType      String?
  results         ResultSource[]
  importBatches   ImportBatch[]
}

model ResultSource {
  resultId String @db.Uuid
  sourceId String @db.Uuid
  result   CandidateResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  source   DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  @@id([resultId, sourceId])
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  passwordHash String?
  role         UserRole @default(DATA_EDITOR)
  active       Boolean @default(true)
  createdAt    DateTime @default(now())
  sessions     Session[]
  auditLogs    AuditLog[]
  imports      ImportBatch[] @relation("UploadedImports")
  reviews      ImportReview[]
}

model Session {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model AuditLog {
  id         String @id @default(uuid()) @db.Uuid
  userId     String? @db.Uuid
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())
  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ImportBatch {
  id             String       @id @default(uuid()) @db.Uuid
  filename       String
  fileType       String
  status         ImportStatus @default(UPLOADED)
  electionId     String?      @db.Uuid
  sourceId       String?      @db.Uuid
  uploadedById   String       @db.Uuid
  totalRows      Int          @default(0)
  validRows      Int          @default(0)
  errorRows      Int          @default(0)
  metadata       Json?
  uploadedAt     DateTime     @default(now())
  validatedAt    DateTime?
  approvedAt     DateTime?
  publishedAt    DateTime?
  uploadedBy     User         @relation("UploadedImports", fields: [uploadedById], references: [id])
  election       Election?    @relation(fields: [electionId], references: [id])
  source         DataSource?  @relation(fields: [sourceId], references: [id])
  rows           ImportRow[]
  reviews        ImportReview[]
  @@index([status, uploadedAt])
}

model ImportRow {
  id           String      @id @default(uuid()) @db.Uuid
  batchId      String      @db.Uuid
  rowNumber    Int
  payload      Json
  status       String      @default("PENDING")
  errors       Json?
  normalized   Json?
  batch        ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  @@unique([batchId, rowNumber])
  @@index([batchId, status])
}

model ImportReview {
  id          String      @id @default(uuid()) @db.Uuid
  batchId     String      @db.Uuid
  reviewerId  String      @db.Uuid
  decision    String
  comment     String?
  createdAt   DateTime    @default(now())
  batch       ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  reviewer    User        @relation(fields: [reviewerId], references: [id])
  @@index([batchId, createdAt])
}
