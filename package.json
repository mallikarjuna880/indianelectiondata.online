{
  "name": "indianelectiondata-platform",
  "private": true,
  "workspaces": ["platform/backend"],
  "scripts": {
    "dev": "npm run dev --workspace platform/backend",
    "build": "npm run build --workspace platform/backend",
    "typecheck": "npm run typecheck --workspace platform/backend",
    "prisma:generate": "prisma generate --schema platform/prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema platform/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema platform/prisma/schema.prisma",
    "db:seed": "tsx platform/prisma/seed.ts",
    "db:reset": "prisma migrate reset --schema platform/prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^6.16.2"
  }
}
